# --- HELP TEXT ---
msgid "Enable this rule"
msgstr "Kích hoạt luật này"

msgid "Select the protocol this rule should match."
msgstr "Chọn giao thức mà luật này áp dụng."

msgid "Source network or alias to match."
msgstr "Địa chỉ mạng hoặc bí danh (alias) nguồn cần khớp."

msgid "Destination network or alias to match."
msgstr "Địa chỉ mạng hoặc bí danh (alias) đích cần khớp."

msgid "The internal IP address to forward traffic to."
msgstr "Địa chỉ IP nội bộ để chuyển tiếp lưu lượng đến."

msgid "Control NAT reflection for this rule."
msgstr "Điều khiển chế độ phản xạ NAT (NAT Loopback) cho luật này."

msgid "Enter a description to identify this rule."
msgstr "Nhập mô tả để nhận diện luật này."

msgid "Log packets that are handled by this rule"
msgstr "Ghi nhật ký các gói tin được xử lý bởi luật này."

msgid "Log packets matching this rule."
msgstr "Ghi nhật ký các gói tin khớp với luật này."

msgid "prevents the firewall from modifying the source port on TCP and UDP packets"
msgstr "Ngăn chặn tường lửa thay đổi cổng nguồn trên các gói tin TCP và UDP."

msgid "Choose which interface this rule applies to. Hint: in most cases, you'll want to use WAN here"
msgstr "Chọn giao diện mạng mà luật này áp dụng. Gợi ý: thông thường bạn sẽ chọn WAN."

msgid "Enter the internal subnet for the 1:1 mapping."
msgstr "Nhập mạng con nội bộ (Private) cho ánh xạ 1:1."

msgid "Enter the external subnet's starting address for the 1:1 mapping or network. This is the address or network the traffic will translate to/from."
msgstr "Nhập địa chỉ bắt đầu của mạng con bên ngoài (Public) cho ánh xạ 1:1."